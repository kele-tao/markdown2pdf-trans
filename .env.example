# ===== AI 服务（界面「配置中心」也能改，改完立即生效，无需重启）=====
# 兼容 OpenAI Chat Completions 协议的任意服务
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 不配置密钥时自动进入「离线演示模式」（mock 翻译引擎），可离线演示全流程
# 也可在界面显式打开：配置中心 → 离线演示模式
M2P_AI_MOCK=true

# ===== AI 调用调优 =====
AI_TIMEOUT=180
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=1.5
AI_MAX_CONCURRENCY=3

# ===== 存储 / 任务 =====
# 数据目录（任务注册表、输出产物、运行期配置）
# M2P_DATA_DIR=./data
M2P_MAX_UPLOAD_MB=100
M2P_MAX_IMAGE_BYTES=5242880
M2P_MAX_CHARS_PER_CHUNK=6000
M2P_TASK_TTL_SECONDS=86400        # 完成任务保留 24 小时
M2P_TASK_CLEANUP_INTERVAL=1800    # 每 30 分钟清理一次
M2P_TRANSLATION_CACHE_MAX=4000
M2P_TRANSLATION_CACHE_TTL=604800  # 7 天

# ===== 字体（内嵌字体目录，换机器输出一致）=====
# M2P_FONT_DIR=./fonts

# ===== 日志 =====
LOG_LEVEL=INFO
# M2P_LOG_FORMAT=json   # 结构化 JSON 日志，便于容器采集

# ===== 服务 =====
M2P_PORT=5000
