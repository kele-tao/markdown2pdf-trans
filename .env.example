# ===== AI 服务配置（必填，至少 1 项才能用翻译功能）=====
# 兼容 OpenAI Chat Completions 协议的服务
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
AI_MODEL=gpt-4o-mini

# ===== AI 调用调优（可选）=====
AI_TIMEOUT=180
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=1.5
AI_MAX_CONCURRENCY=3

# ===== 存储 / 缓存（可选）=====
# 输出目录（默认 ./output）
# M2P_OUTPUT_DIR=/data/m2p-output
M2P_MAX_UPLOAD_MB=100
M2P_CACHE_MAX_ENTRIES=2000
M2P_CACHE_TTL_SECONDS=604800     # 7 天
M2P_TASK_TTL_SECONDS=86400       # 1 天
M2P_TASK_CLEANUP_INTERVAL=1800   # 30 分钟

# ===== 日志（可选）=====
LOG_LEVEL=INFO
